# The .vsix only needs themes/*.json + package.json + README + LICENSE + icon.
# references/ matters most: official artwork NEVER goes into the package.
# vsce rewrites the README images to GitHub URLs, so the previews stay out
# too.
.git/**
.gitignore
.vscodeignore
CLAUDE.md
node_modules/**
package-lock.json
palette/**
references/**
scripts/**
src/**
tests/**
extras/**
tsconfig.json
*.vsix
assets/*.svg
assets/preview-*.png
assets/languages-*.png
